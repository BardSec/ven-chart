# =============================================================================
# ven-chart Environment Configuration
# Copy this file to .env.local for local development
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://venchart:venchart_password@localhost:5432/venchart_db"

# -----------------------------------------------------------------------------
# NextAuth.js
# Used for session management and CSRF protection
# Generate with: openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-replace-in-production"

# -----------------------------------------------------------------------------
# Microsoft Entra ID (Azure AD) — SSO Configuration
#
# Setup steps:
# 1. Go to https://portal.azure.com → Microsoft Entra ID → App registrations
# 2. New registration → Name it "ven-chart" (or your district name)
# 3. Supported account types: "Accounts in this organizational directory only"
# 4. Redirect URI: Web → http://localhost:3000/api/auth/callback/azure-ad
# 5. After creation, copy the Application (client) ID → AZURE_AD_CLIENT_ID
# 6. Copy the Directory (tenant) ID → AZURE_AD_TENANT_ID
# 7. Certificates & secrets → New client secret → copy value → AZURE_AD_CLIENT_SECRET
# 8. API permissions: Add Microsoft Graph → User.Read (delegated)
# -----------------------------------------------------------------------------
AZURE_AD_CLIENT_ID="your-azure-app-client-id"
AZURE_AD_CLIENT_SECRET="your-azure-app-client-secret"
AZURE_AD_TENANT_ID="your-azure-tenant-id"

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# District name displayed in the UI
NEXT_PUBLIC_DISTRICT_NAME="Your School District"

# Default admin email — this user will be granted ADMIN role on first login
# Set to the primary district IT admin's Microsoft account email
ADMIN_EMAIL="admin@yourdistrict.edu"

# App URL (used for absolute links in emails, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# File Upload (Optional)
# If using S3-compatible storage for attachment uploads
# Leave blank to use URL-only attachments
# -----------------------------------------------------------------------------
# S3_BUCKET_NAME=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""  # For non-AWS S3-compatible storage

# -----------------------------------------------------------------------------
# Email Notifications (Optional)
# For renewal reminder emails. Uses SMTP.
# -----------------------------------------------------------------------------
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="ven-chart@yourdistrict.edu"
